---
import ProductCard from "../components/ProductCard.astro";
import {
  business,
  filters,
  hours,
  navItems,
  products,
  quickInfo,
} from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";

const title = "Pastisseria Maika · Reus";
const description =
  "Pastisseria Maika a Reus. Mones personalitzades, figures de xocolata, dolços de temporada, horaris i contacte.";
---

<BaseLayout title={title} description={description}>
  <header class="site-header">
    <nav class="container nav">
      <a href="#inici" class="brand" aria-label={business.name}>
        <img src={withBase(business.logo)} alt={business.name} />
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="nav-links">
        Menú
      </button>
      <div class="nav-links" id="nav-links">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="nav-cta" href={business.phoneHref}>Trucar</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="hero" id="inici">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Pastisseria artesana · {business.location}</p>
          <h1>Endolça la seva vida.</h1>
          <p class="lead">
            Pastisseria Maika crea mones, figures de xocolata i dolços de temporada
            per a celebracions, regals i encàrrecs personalitzats.
          </p>
          <div class="hero-actions">
            <a class="btn primary" href="#productes">Veure productes</a>
            <a class="btn secondary" href={business.phoneHref}>{business.phone}</a>
          </div>
          <div class="info-pills">
            <span>{business.address}</span>
            <span>{business.cityLine}</span>
            <span>Encàrrecs a botiga</span>
          </div>
        </div>
        <div class="hero-media">
          <img src={withBase(business.heroImage)} alt="Mona Frozen de Pastisseria Maika" />
        </div>
      </div>
    </section>

    <section class="quick-info">
      <div class="container quick-grid">
        {
          quickInfo.map((item) => (
            <article>
              <span>{item.label}</span>
              <strong>{item.value}</strong>
            </article>
          ))
        }
      </div>
    </section>

    <section class="intro container">
      <div>
        <p class="section-kicker">Preview web</p>
        <h2>Una web visual per mostrar productes i rebre encàrrecs.</h2>
      </div>
      <p>
        Aquesta maqueta transforma les fotos de producte en una web clara: galeria,
        categories, horaris, ubicació i contacte ràpid per fer encàrrecs.
      </p>
    </section>

    <section class="products" id="productes">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="section-kicker">Galeria</p>
            <h2>Productes destacats</h2>
          </div>
          <div class="filters">
            {
              filters.map((filter) => (
                <button class:list={["filter", { active: filter === "Tots" }]} data-filter={filter}>
                  {filter}
                </button>
              ))
            }
          </div>
        </div>
        <div class="product-grid" id="product-grid">
          {products.map((product) => <ProductCard product={product} />)}
        </div>
      </div>
    </section>

    <section class="orders" id="encarrecs">
      <div class="container orders-grid">
        <div>
          <p class="section-kicker">Encàrrecs</p>
          <h2>Mones, figures i dolços personalitzats.</h2>
          <p>
            La web pot funcionar com a catàleg visual perquè el client vegi exemples
            abans de trucar o passar per la botiga. Les peces especials es preparen
            segons disponibilitat i temporada.
          </p>
          <a class="btn primary" href={business.phoneHref}>Fer una consulta</a>
        </div>
        <div class="order-card">
          <h3>Com funciona?</h3>
          <ol>
            <li>Tria una idea o producte de la galeria.</li>
            <li>Truca a la botiga per consultar disponibilitat.</li>
            <li>Confirma mida, decoració i data de recollida.</li>
          </ol>
        </div>
      </div>
    </section>

    <section class="hours" id="horaris">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="section-kicker">Horaris</p>
            <h2>Obert tota la setmana</h2>
          </div>
        </div>
        <div class="hours-grid">
          {
            hours.map((item) => (
              <article class="hours-card">
                <h3>{item.title}</h3>
                {item.lines.map((line) => <p>{line}</p>)}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="contact" id="contacte">
      <div class="container contact-grid">
        <div>
          <p class="section-kicker">Contacte</p>
          <h2>Visita'ns a Reus.</h2>
          <p>
            Per encàrrecs, disponibilitat de productes o consultes, contacta
            directament amb Pastisseria Maika.
          </p>
          <div class="contact-actions">
            <a class="btn primary" href={business.phoneHref}>
              Trucar al {business.phone}
            </a>
          </div>
          <div class="contact-details">
            <p><strong>Adreça:</strong> {business.fullAddress}</p>
            <p><strong>Telèfon:</strong> {business.phone}</p>
            <p><strong>Servei:</strong> {business.service}</p>
          </div>
        </div>
        <div class="map-card">
          <iframe
            title="Mapa Pastisseria Maika"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            src={business.mapUrl}
          ></iframe>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <span>© 2026 Pastisseria Maika</span>
      <a href="#inici">Tornar amunt</a>
    </div>
  </footer>

  <script src={withBase("scripts/site.js")} defer></script>
</BaseLayout>
